{
    "name": "livewire-support",
    "displayName": "Livewire Support",
    "description": "VS Code extension for Laravel Livewire development support.",
    "version": "0.0.1",
    "publisher": "doonfrs",
    "engines": {
        "vscode": ">=1.70.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/doonfrs/vscode-livewire-support"
    },
    "icon": "images/icon.png",
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:php",
        "onLanguage:blade"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.70.0",
        "@types/node": "^16.0.0",
        "typescript": "^4.7.0",
        "eslint": "^8.0.0"
    },
    "dependencies": {}
}